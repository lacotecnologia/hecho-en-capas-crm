# Copia este archivo como .env y completa los valores.
# El archivo .env nunca se sube a GitHub.

# Conexión a Postgres en tu VPS.
# Agrega ?sslmode=require si tu servidor tiene SSL (recomendado).
DATABASE_URL=postgres://hec_app:CLAVE@tu-vps.com:5432/hecho_en_capas

# Frase secreta para firmar las sesiones (mínimo 32 caracteres).
# Para generar una: openssl rand -base64 48
SESSION_SECRET=

# Opcional: conexiones simultáneas por función (por defecto 3)
# DATABASE_POOL_MAX=3
