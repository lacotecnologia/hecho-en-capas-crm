# Copia este archivo como .env y completa los valores.
# El archivo .env nunca se sube a GitHub.

# Conexión a Postgres en tu VPS.
# Agrega ?sslmode=require si tu servidor tiene SSL (recomendado).
DATABASE_URL=postgres://hec_app:CLAVE@tu-vps.com:5432/hecho_en_capas

# Frase secreta para firmar las sesiones (mínimo 32 caracteres).
# Para generar una: openssl rand -base64 48
SESSION_SECRET=

# Almacenamiento de fotos y archivos 3MF/STL (Vercel Blob).
# Lo crea Vercel al conectar un Blob Store; para tu Mac cópialo de Vercel.
# BLOB_STORE_ID=  (Vercel lo agrega solo al conectar el Blob Store)
# BLOB_READ_WRITE_TOKEN=  (opcional, solo para probar subidas desde tu Mac)

# Opcional: conexiones simultáneas por función (por defecto 3)
# DATABASE_POOL_MAX=3

# Tienda en línea (sitio aparte). ID de cliente de Google (Google Cloud Console >
# Credenciales > ID de cliente de OAuth, tipo "Aplicación web"). Es el mismo que usa la tienda.
GOOGLE_CLIENT_ID=
# Direcciones de la tienda que pueden llamar a esta API, separadas por coma.
# Ejemplo: https://tienda.tudominio.com,http://localhost:8765
TIENDA_ORIGENES=
